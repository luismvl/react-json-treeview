{
    "name": "@luismvl/react-json-treeview",
    "version": "0.1.1",
    "description": "A lightweight, performant React JSON tree viewer with search, navigation, and sticky breadcrumbs.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/styles.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build",
        "lint": "eslint src/ dev/",
        "lint:fix": "eslint src/ dev/ --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"dev/**/*.{ts,tsx}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run lint && npm test && npm run build"
    },
    "author": "Luis Vela",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/luismvl/react-json-treeview.git"
    },
    "homepage": "https://github.com/luismvl/react-json-treeview#readme",
    "bugs": {
        "url": "https://github.com/luismvl/react-json-treeview/issues"
    },
    "keywords": [
        "react",
        "json",
        "tree",
        "viewer",
        "search",
        "typescript"
    ],
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.0.9",
        "@types/react": "^19.2.9",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "jsdom": "^28.0.0",
        "prettier": "^3.8.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.53.1",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    }
}
